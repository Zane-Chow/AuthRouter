# ==================================================
# Personal SSO Middleware - Configuration
# Copy this file to .env and fill in the values
# ==================================================

# --- SSO Middleware ---
# The external URL of this SSO middleware (must be HTTPS)
SSO_BASE_URL=https://sso.zhouhaoze.com
# Internal port (behind reverse proxy)
SSO_PORT=3000

# --- Google OAuth2 (Optional, at least one IdP required) ---
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://sso.zhouhaoze.com/sso/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- GitHub OAuth2 (Optional, at least one IdP required) ---
# Create at: https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL: https://sso.zhouhaoze.com/sso/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# --- Admin Panel ---
# Credentials for the management admin panel at /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Session ---
# Random string for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-hex-string

# --- Data Directory ---
# Where to store SQLite database and JWKS keys
DATA_DIR=./data
