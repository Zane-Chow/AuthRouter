# ==================================================
# Personal SSO Middleware - Configuration
# Copy this file to .env and fill in the values
# ==================================================

# --- SSO Middleware ---
# The external URL of this SSO middleware (must be HTTPS)
SSO_BASE_URL=https://sso.zhouhaoze.com
# Internal port (behind reverse proxy)
SSO_PORT=3000

# --- Database ---
# Chosen at deploy time: 'sqlite' (default, single file under DATA_DIR) or 'mysql'.
DB_DRIVER=sqlite
# Only required when DB_DRIVER=mysql:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sso
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=sso

# --- Admin Panel ---
# Credentials for the management admin panel at /admin.
# Upstream Identity Providers and downstream OIDC clients are configured
# entirely through this panel after deployment — nothing OIDC-related
# belongs in this file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Session ---
# Random string for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-hex-string

# --- Secret Encryption (optional) ---
# 32-byte key (hex or base64) used to encrypt stored client secrets at rest.
# If unset, a key is auto-generated on first run and saved to DATA_DIR/encryption.key.
# Set this explicitly if you need the same key across multiple instances/restores.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Data Directory ---
# Where to store SQLite database (if used), JWKS keys, and the auto-generated
# encryption key.
DATA_DIR=./data
