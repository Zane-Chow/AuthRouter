# ==================================================
# Personal SSO Middleware - Configuration
# Copy this file to .env and modify as needed.
# SQLite works with defaults. MySQL requires the variables noted below.
# ==================================================

# --- Docker Image ---
# Image built and published by GitHub Actions.
# Pin a release tag in production instead of using latest.
# AUTHROUTER_IMAGE=ghcr.io/yiyi-16/authrouter:v2.0

# --- SSO Middleware ---
# The external URL of this SSO middleware (e.g., https://sso.example.com).
# Optional — if unset, defaults to http://localhost:{SSO_PORT}.
# SSO_BASE_URL=https://sso.example.com

# Internal port (behind reverse proxy).
# Default: 3000
# SSO_PORT=3000

# --- Database ---
# 'sqlite' (default) or 'mysql'.
# Default: sqlite (single file stored under DATA_DIR)
# DB_DRIVER=sqlite

# Required when DB_DRIVER=mysql. The database and user must already exist.
# From Docker, localhost means the SSO container itself; use a hostname that
# is reachable from the container when MySQL runs elsewhere.
# MYSQL_HOST=mysql.example.internal
# MYSQL_PORT=3306
# MYSQL_USER=sso
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=sso

# --- Admin Panel ---
# Credentials for the management admin panel at /admin.
# Default username: admin
# Default password: generated once, saved to DATA_DIR/admin.password, and printed once
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-strong-password

# --- Secret Encryption (optional) ---
# 32-byte key (hex or base64) used to encrypt stored client secrets at rest.
# If unset, a key is auto-generated on first run and saved to DATA_DIR/encryption.key.
# Set this explicitly if you need the same key across multiple instances/restores.
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

# --- Data Directory ---
# Where to store SQLite database (if used), JWKS keys, admin password, and keys.
# Default: ./data (resolves to /app/data in the Docker image)
# DATA_DIR=/app/data

# --- Session Secret (optional) ---
# Key used to sign session cookies (admin login + in-flight OIDC interactions).
# If unset, a key is auto-generated on first run and saved to DATA_DIR/session.key,
# so restarts don't invalidate existing sessions/cookies.
# Set this explicitly if you need the same key across multiple instances/restores.
# SESSION_SECRET=

# --- Upstream HTTP ---
# Timeout for OIDC discovery, token, userinfo, and email endpoint requests.
# Default: 10000 milliseconds
# UPSTREAM_TIMEOUT_MS=10000
