<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AuthRouter 管理面板</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/style.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-mono/style.min.css" rel="stylesheet">
  <style>
    /* ── Design Tokens ─────────────────────────────── */
    :root {
      --bg-base: #07070d;
      --bg-elevated: rgba(255, 255, 255, 0.03);
      --bg-hover: rgba(255, 255, 255, 0.05);
      --border-subtle: rgba(255, 255, 255, 0.07);
      --border-hover: rgba(255, 255, 255, 0.12);
      --text-primary: #f1f5f9;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --accent: #10b981;
      --accent-hover: #059669;
      --accent-subtle: rgba(16, 185, 129, 0.10);
      --accent-border: rgba(16, 185, 129, 0.20);
      --error: #ef4444;
      --error-subtle: rgba(239, 68, 68, 0.08);
      --error-border: rgba(239, 68, 68, 0.15);
      --error-text: #fca5a5;
      --success-subtle: rgba(16, 185, 129, 0.08);
      --success-border: rgba(16, 185, 129, 0.15);
      --success-text: #6ee7b7;
      --radius: 8px;
      --radius-lg: 12px;
      --font-sans: 'Geist', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      --font-mono: 'Geist Mono', 'SF Mono', 'Fira Code', 'Consolas', monospace;
    }

    /* ── Reset ──────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-base);
      color: var(--text-primary);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* ── Navbar ─────────────────────────────────────── */
    .navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      height: 56px;
      background: rgba(7, 7, 13, 0.85);
      border-bottom: 1px solid var(--border-subtle);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .navbar-brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-primary);
    }
    .navbar-brand .icon {
      width: 28px;
      height: 28px;
      border-radius: var(--radius);
      background: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
    }
    .navbar-brand .icon svg { width: 14px; height: 14px; }

    /* ── Buttons ────────────────────────────────────── */
    .btn-sm {
      padding: 0.35rem 0.75rem;
      border-radius: var(--radius);
      font-family: var(--font-sans);
      font-size: 0.78rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, color 0.15s;
      border: 1px solid var(--border-subtle);
      background: transparent;
      color: var(--text-secondary);
      line-height: 1.4;
    }
    .btn-sm:hover {
      background: var(--bg-hover);
      border-color: var(--border-hover);
      color: var(--text-primary);
    }
    .btn-sm:active { transform: scale(0.98); }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.55rem 1.15rem;
      border-radius: var(--radius);
      font-family: var(--font-sans);
      font-size: 0.84rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s, box-shadow 0.15s, transform 0.1s;
      border: none;
      line-height: 1.4;
    }
    .btn:active { transform: scale(0.98); }
    .btn-primary {
      background: var(--accent);
      color: #fff;
      width: 100%;
    }
    .btn-primary:hover {
      background: var(--accent-hover);
      box-shadow: 0 2px 12px rgba(16, 185, 129, 0.2);
    }
    .btn-add {
      background: var(--accent-subtle);
      border: 1px solid var(--accent-border);
      color: var(--success-text);
    }
    .btn-add:hover {
      background: rgba(16, 185, 129, 0.18);
      border-color: rgba(16, 185, 129, 0.3);
    }
    .btn-danger {
      background: var(--error-subtle);
      border: 1px solid var(--error-border);
      color: var(--error-text);
      padding: 0.3rem 0.65rem;
      font-size: 0.76rem;
      border-radius: var(--radius);
      font-family: var(--font-sans);
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
      line-height: 1.4;
    }
    .btn-danger:hover {
      background: rgba(239, 68, 68, 0.16);
      border-color: rgba(239, 68, 68, 0.25);
    }
    .btn-danger:active { transform: scale(0.98); }

    /* ── Layout ─────────────────────────────────────── */
    .main {
      max-width: 1024px;
      margin: 0 auto;
      padding: 2rem;
    }
    @media (max-width: 640px) {
      .main { padding: 1.25rem; }
      .navbar { padding: 0 1.25rem; }
    }

    /* ── Login Card ─────────────────────────────────── */
    .login-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: calc(100vh - 56px);
      padding: 1.5rem;
    }
    .login-card {
      width: 100%;
      max-width: 380px;
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2rem;
      animation: fadeUp 0.35s ease;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .login-card h2 {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 0.25rem;
    }
    .login-card .subtitle {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }

    /* ── Forms ──────────────────────────────────────── */
    .form-group { margin-bottom: 0.875rem; }
    .form-group label {
      display: block;
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--text-secondary);
      margin-bottom: 0.3rem;
    }
    .form-group input,
    .form-group select {
      width: 100%;
      padding: 0.55rem 0.7rem;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      color: var(--text-primary);
      font-family: var(--font-sans);
      font-size: 0.84rem;
      transition: border-color 0.15s, box-shadow 0.15s;
      outline: none;
      line-height: 1.4;
    }
    .form-group input:focus,
    .form-group select:focus {
      border-color: rgba(16, 185, 129, 0.45);
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.08);
    }
    .form-group input::placeholder { color: var(--text-muted); }
    .form-group select option { background: #18181b; color: var(--text-primary); }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
    @media (max-width: 640px) {
      .form-row { grid-template-columns: 1fr; }
    }
    .form-actions {
      margin-top: 1rem;
      display: flex;
      justify-content: flex-end;
    }

    /* ── Alerts ─────────────────────────────────────── */
    .alert {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 0.875rem;
      border-radius: var(--radius);
      font-size: 0.82rem;
      margin-bottom: 1.25rem;
      animation: fadeIn 0.25s ease;
      line-height: 1.5;
    }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .alert svg { flex-shrink: 0; width: 15px; height: 15px; }
    .alert-success {
      background: var(--success-subtle);
      border: 1px solid var(--success-border);
      color: var(--success-text);
    }
    .alert-error {
      background: var(--error-subtle);
      border: 1px solid var(--error-border);
      color: var(--error-text);
    }

    /* ── Sections ───────────────────────────────────── */
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
      margin-top: 0.5rem;
    }
    .section-header h2 {
      font-size: 1rem;
      font-weight: 600;
    }
    .section-header .count {
      font-size: 0.72rem;
      font-family: var(--font-mono);
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.04);
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
    }
    .add-section {
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      margin-bottom: 2rem;
    }
    .add-section h3 {
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 0.875rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .add-section h3 svg { width: 16px; height: 16px; color: var(--accent); }

    /* ── Table ──────────────────────────────────────── */
    .table-wrapper {
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-bottom: 1.5rem;
    }
    .table-scroll { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 600px; }
    thead th {
      text-align: left;
      padding: 0.65rem 1rem;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.02);
      border-bottom: 1px solid var(--border-subtle);
      letter-spacing: 0.02em;
    }
    tbody td {
      padding: 0.7rem 1rem;
      font-size: 0.84rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.03);
      vertical-align: middle;
    }
    tbody tr:hover { background: var(--bg-hover); }
    tbody tr:last-child td { border-bottom: none; }

    /* ── Empty State ────────────────────────────────── */
    .empty-state {
      text-align: center;
      padding: 2.5rem 2rem;
      color: var(--text-muted);
    }
    .empty-state .empty-icon {
      width: 40px;
      height: 40px;
      margin: 0 auto 0.75rem;
      color: var(--text-muted);
      opacity: 0.5;
    }
    .empty-state p { font-size: 0.84rem; }

    /* ── Misc ──────────────────────────────────────── */
    .badge {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 500;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-secondary);
      font-family: var(--font-mono);
    }
    .mono {
      font-family: var(--font-mono);
      font-size: 0.8rem;
    }
    .status-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }
    .status-dot.active { background: var(--accent); box-shadow: 0 0 6px rgba(16, 185, 129, 0.4); }
    .status-dot.inactive { background: #52525b; }

    .actions-cell { display: flex; gap: 0.4rem; align-items: center; }

    .edit-row { display: none; }
    .edit-row.open { display: table-row; }
    .edit-row-inner {
      padding: 1rem 1.25rem;
      background: rgba(255, 255, 255, 0.015);
    }
    .reveal-section {
      border-color: var(--accent-border);
      background: var(--accent-subtle);
    }
    .reveal-section h3 {
      color: var(--success-text);
    }
    .reset-warning {
      font-size: 0.78rem;
      color: var(--error-text);
      margin-top: 0.35rem;
      display: none;
    }
    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }
    .checkbox-row input[type="checkbox"] { width: auto; accent-color: var(--accent); }
    .checkbox-row label { margin: 0; cursor: pointer; font-size: 0.78rem; color: var(--text-secondary); }
    .permission-box {
      margin-top: 0.875rem;
      padding: 0.75rem;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.02);
    }
    .permission-title { font-size: 0.78rem; font-weight: 500; color: var(--text-secondary); }
    .permission-options { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-top: 0.55rem; }
    .permission-option { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.78rem; color: var(--text-secondary); cursor: pointer; }
    .permission-option input { width: auto; accent-color: var(--accent); }
    .permission-help { margin-top: 0.5rem; font-size: 0.73rem; color: var(--text-muted); }
    .hint-text { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 0.875rem; }
  </style>
</head>
<body>
  <% if (!loggedIn) { %>
    <nav class="navbar">
      <div class="navbar-brand">
        <div class="icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
        </div>
        <span>AuthRouter</span>
      </div>
    </nav>
    <div class="login-wrapper">
      <div class="login-card">
        <h2>管理面板登录</h2>
        <p class="subtitle">管理 OIDC 客户端与身份映射</p>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span><%= error %></span>
          </div>
        <% } %>
        <form method="POST" action="/admin/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="login-username">用户名</label>
            <input type="text" id="login-username" name="username" placeholder="admin" required autocomplete="username">
          </div>
          <div class="form-group">
            <label for="login-password">密码</label>
            <input type="password" id="login-password" name="password" required autocomplete="current-password">
          </div>
          <button type="submit" class="btn btn-primary">登录</button>
        </form>
      </div>
    </div>
  <% } else { %>
    <nav class="navbar">
      <div class="navbar-brand">
        <div class="icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
        </div>
        <span>AuthRouter</span>
      </div>
      <form method="POST" action="/admin/logout" style="margin:0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-sm">退出登录</button>
      </form>
    </nav>
    <div class="main">
      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span><%= message %></span>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (typeof reveal !== 'undefined' && reveal) { %>
        <div class="add-section reveal-section">
          <h3>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            客户端 <%= reveal.clientName %> 创建成功
          </h3>
          <p class="hint-text" style="color: var(--error-text);">请立即复制 Client Secret，关闭本页后将无法再次查看明文。</p>
          <div class="form-group">
            <label>Client ID</label>
            <input type="text" class="mono" value="<%= reveal.clientId %>" readonly onclick="this.select()">
          </div>
          <div class="form-group">
            <label>Client Secret</label>
            <input type="text" class="mono" value="<%= reveal.clientSecret %>" readonly onclick="this.select()">
          </div>
        </div>
      <% } %>

      <div class="section-header">
        <h2>管理 API</h2>
        <span class="badge"><%= apiConfig.enabled ? '已开启' : '已关闭' %></span>
      </div>
      <div class="add-section">
        <p class="hint-text">开启后，可通过 API Token 管理上游身份提供商、下游客户端和身份映射。Token 拥有全部管理 API 权限，请妥善保管。</p>
        <p class="hint-text">Token：<%= apiConfig.hasToken ? '已生成' : '未生成' %><% if (apiConfig.tokenCreatedAt) { %> · 最近生成于 <%= apiConfig.tokenCreatedAt %><% } %></p>
        <% if (typeof apiToken !== 'undefined' && apiToken) { %>
          <div class="form-group">
            <label for="api-token">API Token</label>
            <input type="text" class="mono" id="api-token" value="<%= apiToken %>" readonly onclick="this.select()" autocomplete="off" spellcheck="false">
          </div>
          <p class="hint-text" style="color: var(--error-text);">明文仅在本次生成后显示。离开此页后无法再次查看，请立即复制保存。</p>
        <% } %>
        <div class="actions-cell" style="flex-wrap:wrap">
          <form method="POST" action="/admin/api/settings" style="margin:0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="enabled" value="<%= apiConfig.enabled ? '0' : '1' %>">
            <button type="submit" class="btn <%= apiConfig.enabled ? 'btn-danger' : 'btn-add' %>" <%= !apiConfig.enabled && !apiConfig.hasToken ? 'disabled' : '' %>><%= apiConfig.enabled ? '关闭 API' : '开启 API' %></button>
          </form>
          <form method="POST" action="/admin/api/token" style="margin:0" <% if (apiConfig.hasToken) { %>onsubmit="return confirm('重新生成后，旧 Token 会立即失效。确定继续？')"<% } %>>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-add"><%= apiConfig.hasToken ? '重新生成 Token' : '生成 API Token' %></button>
          </form>
        </div>
        <% if (!apiConfig.hasToken) { %><p class="permission-help">先生成并保存 Token，再开启 API。</p><% } %>
        <p class="permission-help">请求路径：/api/* · 鉴权：Authorization: Bearer &lt;Token&gt; · 关闭 API 后所有 Token 请求均被拒绝。</p>
      </div>

      <!-- Clients Section -->
      <div class="section-header">
        <h2>OIDC 客户端</h2>
        <span class="count"><%= clients.length %></span>
      </div>
      <div class="table-wrapper">
        <% if (clients.length === 0) { %>
          <div class="empty-state">
            <svg class="empty-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M2 12h7"/><path d="M15 12h7"/></svg>
            <p>暂无注册的客户端</p>
          </div>
        <% } else { %>
          <div class="table-scroll">
            <table>
              <thead><tr><th>Client ID</th><th>名称</th><th>回调地址</th><th>认证方式</th><th>上游权限</th><th>状态</th><th>操作</th></tr></thead>
              <tbody>
                <% clients.forEach(c => {
                  const uris = typeof c.redirect_uris === 'string' ? JSON.parse(c.redirect_uris) : c.redirect_uris;
                %>
                  <tr>
                    <td class="mono"><%= c.client_id %></td>
                    <td><%= c.client_name %></td>
                    <td class="mono" style="font-size:0.73rem; max-width:200px; word-wrap:break-word"><%= uris.join(', ') %></td>
                    <td><span class="badge"><%= c.token_endpoint_auth_method %></span></td>
                    <td>
                      <% if (!c.allowed_providers || c.allowed_providers.length === 0) { %>
                        <span class="badge">全部</span>
                      <% } else { c.allowed_providers.forEach(providerId => { %>
                        <span class="badge"><%= providerId %></span>
                      <% }); } %>
                    </td>
                    <td><span class="status-dot <%= c.enabled ? 'active' : 'inactive' %>"></span></td>
                    <td>
                      <div class="actions-cell">
                        <button type="button" class="btn-sm" onclick="document.getElementById('edit-client-<%= c.client_id %>').classList.toggle('open')">编辑</button>
                        <form method="POST" action="/admin/clients/<%= c.client_id %>/delete" onsubmit="return confirm('确定删除客户端 <%= c.client_name %>？相关映射也会被删除。')" style="margin:0">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn-danger">删除</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  <tr id="edit-client-<%= c.client_id %>" class="edit-row">
                    <td colspan="7" style="padding:0; border-bottom:1px solid rgba(255,255,255,0.03);">
                      <div class="edit-row-inner">
                        <form method="POST" action="/admin/clients/<%= c.client_id %>/update">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <div class="form-row">
                            <div class="form-group"><label>名称</label><input type="text" name="client_name" value="<%= c.client_name %>" required></div>
                            <div class="form-group"><label>回调地址 (逗号分隔)</label><input type="text" name="redirect_uris" value="<%= uris.join(', ') %>" required></div>
                            <div class="form-group">
                              <label>认证方式</label>
                              <select name="token_auth_method">
                                <option value="client_secret_post" <%= c.token_endpoint_auth_method === 'client_secret_post' ? 'selected' : '' %>>client_secret_post</option>
                                <option value="client_secret_basic" <%= c.token_endpoint_auth_method === 'client_secret_basic' ? 'selected' : '' %>>client_secret_basic</option>
                              </select>
                            </div>
                            <div class="form-group"><label>Scope</label><input type="text" name="scope" value="<%= c.scope %>"></div>
                          </div>
                          <div class="checkbox-row">
                            <input type="checkbox" name="reset_secret" value="1" id="reset-secret-<%= c.client_id %>" onchange="this.closest('form').querySelector('.reset-warning').style.display = this.checked ? 'block' : 'none'">
                            <label for="reset-secret-<%= c.client_id %>">重新生成 Client Secret（Client ID 保持不变）</label>
                          </div>
                          <div class="permission-box">
                            <div class="permission-title">允许使用的上游 IdP</div>
                            <div class="permission-options">
                              <% providers.forEach(p => { %>
                                <label class="permission-option">
                                  <input type="checkbox" name="allowed_providers" value="<%= p.provider_id %>" <%= c.allowed_providers?.includes(p.provider_id) ? 'checked' : '' %>>
                                  <span><%= p.display_name %> (<%= p.provider_id %>)</span>
                                </label>
                              <% }); %>
                            </div>
                            <div class="permission-help">不勾选表示允许全部已启用上游；勾选后仅允许选中的上游。</div>
                          </div>
                          <p class="reset-warning">旧密钥将立即失效，下游系统需同步更新为新密钥。</p>
                          <div class="form-actions"><button type="submit" class="btn btn-add" style="width:auto;">保存修改</button></div>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <div class="add-section">
        <h3>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          添加客户端
        </h3>
        <p class="hint-text">Client ID 和 Client Secret 将由服务器自动生成，创建后仅显示一次。</p>
        <form method="POST" action="/admin/clients">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-row">
            <div class="form-group"><label for="add-client-name">名称</label><input type="text" id="add-client-name" name="client_name" required></div>
            <div class="form-group"><label for="add-client-uris">回调地址 (逗号分隔)</label><input type="text" id="add-client-uris" name="redirect_uris" required></div>
            <div class="form-group">
              <label for="add-client-auth">认证方式</label>
              <select id="add-client-auth" name="token_auth_method">
                <option value="client_secret_post">client_secret_post</option>
                <option value="client_secret_basic">client_secret_basic</option>
              </select>
            </div>
            <div class="form-group"><label for="add-client-scope">Scope</label><input type="text" id="add-client-scope" name="scope" value="openid email profile"></div>
          </div>
          <div class="permission-box">
            <div class="permission-title">允许使用的上游 IdP</div>
            <div class="permission-options">
              <% providers.forEach(p => { %>
                <label class="permission-option">
                  <input type="checkbox" name="allowed_providers" value="<%= p.provider_id %>">
                  <span><%= p.display_name %> (<%= p.provider_id %>)</span>
                </label>
              <% }); %>
            </div>
            <div class="permission-help">不勾选表示允许全部已启用上游；例如只勾选 Google 和 GitHub，即可限制该客户端只能使用这两个上游。</div>
          </div>
          <div class="form-actions"><button type="submit" class="btn btn-add" style="width:auto;">添加客户端</button></div>
        </form>
      </div>

      <!-- Upstream Providers Section -->
      <div class="section-header">
        <h2>上游身份提供商</h2>
        <span class="count"><%= providers.length %></span>
      </div>
      <div class="table-wrapper">
        <% if (providers.length === 0) { %>
          <div class="empty-state">
            <svg class="empty-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            <p>暂无上游 IdP，登录功能不可用。请在下方添加至少一个。</p>
          </div>
        <% } else { %>
          <div class="table-scroll">
            <table>
              <thead><tr><th>标识</th><th>名称</th><th>类型</th><th>状态</th><th>操作</th></tr></thead>
              <tbody>
                <% providers.forEach(p => { %>
                  <tr>
                    <td class="mono"><%= p.provider_id %></td>
                    <td><%= p.display_name %></td>
                    <td><span class="badge"><%= p.type %></span></td>
                    <td><span class="status-dot <%= p.enabled ? 'active' : 'inactive' %>"></span></td>
                    <td>
                      <div class="actions-cell">
                        <form method="POST" action="/admin/upstream-providers/<%= p.id %>/toggle" style="margin:0">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn-sm"><%= p.enabled ? '禁用' : '启用' %></button>
                        </form>
                        <form method="POST" action="/admin/upstream-providers/<%= p.id %>/delete" onsubmit="return confirm('确定删除上游 IdP <%= p.display_name %>？')" style="margin:0">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn-danger">删除</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <div class="add-section">
        <h3>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          添加上游 IdP
        </h3>
        <form method="POST" action="/admin/upstream-providers">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-row">
            <div class="form-group"><label for="add-idp-id">标识 (英文, 如 google / company-sso)</label><input type="text" id="add-idp-id" name="provider_id" required></div>
            <div class="form-group"><label for="add-idp-name">显示名称</label><input type="text" id="add-idp-name" name="display_name" required></div>
            <div class="form-group">
              <label for="add-idp-type">类型</label>
              <select id="add-idp-type" name="type" onchange="toggleProviderFields(this.value)">
                <option value="oidc">OIDC (标准协议，自动发现)</option>
                <option value="oauth2">OAuth2 (手动配置端点)</option>
              </select>
            </div>
            <div class="form-group"><label for="add-idp-client-id">Client ID</label><input type="text" id="add-idp-client-id" name="client_id" required></div>
            <div class="form-group"><label for="add-idp-client-secret">Client Secret</label><input type="text" id="add-idp-client-secret" name="client_secret" required></div>
            <div class="form-group"><label for="add-idp-scope">Scope</label><input type="text" id="add-idp-scope" name="scope" placeholder="openid email profile"></div>
            <div class="form-group"><label for="add-idp-icon">图标 (可选)</label><input type="text" id="add-idp-icon" name="icon" placeholder="generic"></div>
          </div>

          <div class="form-row oidc-fields" style="margin-top:0.75rem;">
            <div class="form-group"><label for="add-idp-issuer">Issuer</label><input type="text" id="add-idp-issuer" name="issuer" placeholder="https://accounts.google.com"></div>
          </div>

          <div class="oauth2-fields" style="display:none; margin-top:0.75rem;">
            <div class="form-row">
              <div class="form-group"><label>Authorize URL</label><input type="text" name="authorize_url"></div>
              <div class="form-group"><label>Token URL</label><input type="text" name="token_url"></div>
              <div class="form-group"><label>Userinfo URL</label><input type="text" name="userinfo_url"></div>
              <div class="form-group"><label>Email URL (可选)</label><input type="text" name="email_url"></div>
            </div>
            <div class="form-row" style="margin-top:0.75rem;">
              <div class="form-group"><label>字段映射: ID</label><input type="text" name="field_id" placeholder="id"></div>
              <div class="form-group"><label>字段映射: Email</label><input type="text" name="field_email" placeholder="email"></div>
              <div class="form-group"><label>字段映射: 名称</label><input type="text" name="field_name" placeholder="name"></div>
              <div class="form-group"><label>字段映射: 头像</label><input type="text" name="field_avatar" placeholder="avatar_url"></div>
            </div>
          </div>

          <div class="form-actions"><button type="submit" class="btn btn-add" style="width:auto;">添加上游 IdP</button></div>
        </form>
      </div>

      <script>
        function toggleProviderFields(type) {
          document.querySelectorAll('.oidc-fields').forEach(el => el.style.display = type === 'oidc' ? '' : 'none');
          document.querySelectorAll('.oauth2-fields').forEach(el => el.style.display = type === 'oauth2' ? '' : 'none');
        }
      </script>

      <!-- Mappings Section -->
      <div class="section-header">
        <h2>身份映射</h2>
        <span class="count"><%= mappings.length %></span>
      </div>
      <div class="table-wrapper">
        <% if (mappings.length === 0) { %>
          <div class="empty-state">
            <svg class="empty-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <p>暂无映射。默认使用上游 IdP 返回的原始身份。</p>
          </div>
        <% } else { %>
          <div class="table-scroll">
            <table>
              <thead><tr><th>客户端</th><th>平台</th><th>来源身份</th><th></th><th>目标身份</th><th>显示名称</th><th>操作</th></tr></thead>
              <tbody>
                <% mappings.forEach(m => { %>
                  <tr>
                    <td class="mono"><%= m.client_id %></td>
                    <td><span class="badge"><%= m.provider %></span></td>
                    <td class="mono"><%= m.provider_identity %></td>
                    <td style="color:var(--text-muted); font-size:0.9rem;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </td>
                    <td class="mono"><%= m.target_identity %></td>
                    <td style="color:var(--text-secondary)"><%= m.display_name || '-' %></td>
                    <td>
                      <form method="POST" action="/admin/mappings/<%= m.id %>/delete" onsubmit="return confirm('确定删除此映射？')" style="margin:0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-danger">删除</button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <div class="add-section">
        <h3>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          添加映射
        </h3>
        <form method="POST" action="/admin/mappings">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-row">
            <div class="form-group">
              <label for="add-map-client">客户端</label>
              <select id="add-map-client" name="client_id" required>
                <% clients.forEach(c => { %><option value="<%= c.client_id %>"><%= c.client_name %> (<%= c.client_id %>)</option><% }); %>
              </select>
            </div>
            <div class="form-group">
              <label for="add-map-provider">登录平台</label>
              <select id="add-map-provider" name="provider_type">
                <% enabledProviders.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }); %>
              </select>
            </div>
            <div class="form-group"><label for="add-map-source">来源身份</label><input type="text" id="add-map-source" name="provider_identity" required></div>
            <div class="form-group"><label for="add-map-target">目标身份</label><input type="text" id="add-map-target" name="target_identity" required></div>
            <div class="form-group"><label for="add-map-display">显示名称 (可选)</label><input type="text" id="add-map-display" name="display_name"></div>
          </div>
          <div class="form-actions"><button type="submit" class="btn btn-add" style="width:auto;">添加映射</button></div>
        </form>
      </div>

    </div>
  <% } %>
</body>
</html>
