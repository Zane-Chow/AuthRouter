<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>错误 - SSO</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/style.min.css" rel="stylesheet">
  <style>
    :root {
      --bg-base: #07070d;
      --bg-elevated: rgba(255, 255, 255, 0.03);
      --border-subtle: rgba(255, 255, 255, 0.07);
      --border-hover: rgba(255, 255, 255, 0.12);
      --text-primary: #f1f5f9;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --error: #ef4444;
      --error-subtle: rgba(239, 68, 68, 0.08);
      --error-border: rgba(239, 68, 68, 0.12);
      --error-text: #fca5a5;
      --radius: 8px;
      --radius-lg: 12px;
      --font-sans: 'Geist', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-base);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      -webkit-font-smoothing: antialiased;
    }
    .card {
      width: 100%;
      max-width: 420px;
      background: var(--bg-elevated);
      border: 1px solid var(--error-border);
      border-radius: var(--radius-lg);
      padding: 2.25rem 2rem;
      text-align: center;
      animation: fadeUp 0.35s ease;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .icon {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-lg);
      background: var(--error-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.15rem;
      color: var(--error-text);
    }
    .icon svg { width: 22px; height: 22px; }
    h2 {
      font-size: 1.05rem;
      font-weight: 600;
      margin-bottom: 0.4rem;
      color: var(--error-text);
    }
    .message {
      font-size: 0.84rem;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: 0.6rem;
    }
    .hint {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-bottom: 1.25rem;
    }
    .actions {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
    }
    .btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.5rem 1rem;
      border-radius: var(--radius);
      font-family: var(--font-sans);
      font-size: 0.82rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, transform 0.1s;
      text-decoration: none;
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      line-height: 1.4;
    }
    .btn-ghost:hover {
      background: rgba(255, 255, 255, 0.04);
      border-color: var(--border-hover);
      color: var(--text-primary);
    }
    .btn-ghost:active { transform: scale(0.98); }
    .btn-ghost svg { width: 14px; height: 14px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <h2>登录失败</h2>
    <p class="message"><%= message || '发生未知错误' %></p>
    <% if (typeof hint !== 'undefined' && hint) { %>
      <p class="hint"><%= hint %></p>
    <% } %>
    <div class="actions">
      <a href="javascript:history.back()" class="btn-ghost">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        返回
      </a>
    </div>
  </div>
</body>
</html>
