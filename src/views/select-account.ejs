<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>选择账号 - SSO</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/style.min.css" rel="stylesheet">
  <style>
    :root {
      --bg-base: #07070d;
      --bg-elevated: rgba(255, 255, 255, 0.03);
      --bg-hover: rgba(255, 255, 255, 0.05);
      --border-subtle: rgba(255, 255, 255, 0.07);
      --border-hover: rgba(255, 255, 255, 0.12);
      --text-primary: #f1f5f9;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --accent: #10b981;
      --accent-hover: #059669;
      --radius: 8px;
      --radius-lg: 12px;
      --font-sans: 'Geist', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      --font-mono: 'Geist Mono', 'SF Mono', 'Fira Code', monospace;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-base);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      -webkit-font-smoothing: antialiased;
    }
    .card {
      width: 100%;
      max-width: 420px;
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2rem;
      animation: fadeUp 0.35s ease;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .profile {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      padding-bottom: 1.25rem;
      margin-bottom: 1.25rem;
      border-bottom: 1px solid var(--border-subtle);
    }
    .avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255, 255, 255, 0.08);
      flex-shrink: 0;
      background: #18181b;
    }
    .profile-info h3 {
      font-size: 0.92rem;
      font-weight: 600;
      line-height: 1.3;
      color: #e2e8f0;
    }
    .profile-info p {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 0.125rem;
    }
    .provider-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.68rem;
      font-weight: 500;
      color: var(--text-secondary);
      background: rgba(255, 255, 255, 0.05);
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      margin-top: 0.3rem;
      font-family: var(--font-mono);
    }
    .heading {
      font-size: 0.84rem;
      font-weight: 500;
      color: var(--text-secondary);
      margin-bottom: 0.75rem;
    }
    .accounts {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .account-form { display: contents; }
    .account-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 0.75rem 0.875rem;
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, transform 0.1s;
      color: var(--text-primary);
      font-family: var(--font-sans);
      text-align: left;
      opacity: 0;
      animation: itemIn 0.3s ease forwards;
    }
    @keyframes itemIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .account-btn:hover {
      background: rgba(16, 185, 129, 0.06);
      border-color: rgba(16, 185, 129, 0.2);
      transform: translateY(-1px);
    }
    .account-btn:active {
      transform: translateY(0);
      background: rgba(16, 185, 129, 0.1);
    }
    .account-identity {
      font-size: 0.88rem;
      font-weight: 500;
      line-height: 1.4;
    }
    .account-name {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.1rem;
    }
    .arrow {
      color: var(--text-muted);
      transition: color 0.15s, transform 0.15s;
      flex-shrink: 0;
      margin-left: 0.5rem;
    }
    .arrow svg { width: 16px; height: 16px; }
    .account-btn:hover .arrow {
      color: var(--accent);
      transform: translateX(2px);
    }
    .user-icon {
      width: 32px;
      height: 32px;
      border-radius: var(--radius);
      background: rgba(16, 185, 129, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-right: 0.7rem;
      color: var(--accent);
    }
    .user-icon svg { width: 16px; height: 16px; }
    .account-btn-inner {
      display: flex;
      align-items: center;
      flex: 1;
      min-width: 0;
    }
    .account-text { min-width: 0; }
    .footer {
      margin-top: 1.25rem;
      padding-top: 0.875rem;
      border-top: 1px solid rgba(255, 255, 255, 0.04);
      text-align: center;
    }
    .footer p {
      font-size: 0.72rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="profile">
      <img class="avatar" src="<%= userAvatar || '' %>" alt="avatar" onerror="this.style.display='none'">
      <div class="profile-info">
        <h3><%= userName || '用户' %></h3>
        <p><%= userEmail %></p>
        <span class="provider-badge"><%= providerName %></span>
      </div>
    </div>

    <p class="heading">选择要登录的身份</p>

    <div class="accounts">
      <% accounts.forEach((account, index) => { %>
        <form class="account-form" method="POST" action="/interaction/<%= uid %>/select">
          <input type="hidden" name="selected_account" value="<%= account.target_identity %>">
          <button type="submit" class="account-btn" style="animation-delay: <%= 0.1 + index * 0.06 %>s">
            <div class="account-btn-inner">
              <div class="user-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <div class="account-text">
                <div class="account-identity"><%= account.target_identity %></div>
                <% if (account.display_name) { %>
                  <div class="account-name"><%= account.display_name %></div>
                <% } %>
              </div>
            </div>
            <span class="arrow">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </button>
        </form>
      <% }); %>
    </div>
    <div class="footer">
      <p>使用 <%= providerName %> 关联身份登录</p>
    </div>
  </div>
</body>
</html>
